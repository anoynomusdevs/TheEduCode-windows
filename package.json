{
  "name": "edocode-browser",
  "version": "1.5.1",
  "main": "main.loader.js",
  "description": "Electron browser for a single URL in kiosk mode.",
  "author": "Eduniketan Private Limited",
  "scripts": {
    "compile": "npx electron .\\support_files\\build.js",
    "package": "electron-packager . TheEduCode --platform=win32 --arch=x64 --out=dist --overwrite --icon=icon.ico --executable-name=TheEduCode --asar --ignore=\"(support_files|compilers|Windows Updater|build-updater\\.ps1|dist|theeducode-updater\\.exe|\\.github|\\.vscode|README\\.md|package-lock\\.json|assests|execution|bundle.*\\.js|.*\\.original\\.js|main\\.js|bootstrapper\\.js|bin)$\""
  },
  "dependencies": {
    "bytenode": "^1.5.7",
    "crypto": "^1.0.1",
    "crypto-js": "^4.2.0",
    "express": "^4.22.2",
    "socket.io-client": "^4.8.1",
    "sudo-prompt": "^9.2.1"
  },
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.28.2"
  },
  "build": {
    "files": [
      "main.loader.js",
      "main.jsc",
      "main.js",
      "index.html",
      "preload.js",
      "icon.ico",
      "icon.png",
      "package.json",
      "node_modules/**/*",
      "bootstrapper.js",
      "execution/**/*"
    ]
  }
}
